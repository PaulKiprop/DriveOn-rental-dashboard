{
  "name": "driveon-backend",
  "version": "1.0.0",
  "description": "DriveOn Car Rental Dashboard API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "esbuild": "0.28.2",
    "nodemon": "^3.1.7",
    "tsx": "4.23.13",
    "typescript": "^5.6.2"
  }
}
